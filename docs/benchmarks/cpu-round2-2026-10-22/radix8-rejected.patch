+    /// Stable payload order and every skipped-pass parity, including the
+    /// highest byte: all 32 key bits participate in the four-pass sort.
+    #[test]
+    fn radix_sort_keeps_ties_and_all_key_bits() {
+        let mut scratch = RadixScratch::default();
+        for n in [0, 1, 63, RADIX_MIN_LEN - 1, RADIX_MIN_LEN, 10_007] {
+            for varying in [
+                0,
+                0xff,
+                0xff00,
+                0xff_0000,
+                0xff00_0000,
+                0xffff,
+                0xff_ffff,
+                u32::MAX,
+            ] {
+                let mut items: Vec<(u32, usize)> = (0..n)
+                    .map(|i| {
+                        let key = (i as u32).wrapping_mul(2_654_435_761) & varying;
+                        (key | (0xa5a5_a5a5 & !varying), i)
+                    })
+                    .collect();
+                let mut expected = items.clone();
+                expected.sort_by_key(|&(key, _)| key);
+                radix_sort(&mut items, &mut scratch, |&(key, _)| key);
+                assert_eq!(items, expected, "n={n}, mask={varying:x}");
+            }
+        }
+    }
