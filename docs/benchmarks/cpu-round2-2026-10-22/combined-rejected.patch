+            let row_ptr = row_offsets(data, false);
+            let mut bins = vec![R::default(); row_ptr[rows.end] - row_ptr[rows.start]];
+            let mut columns =
+                vec![C::default(); if keep_columns { len * data.n_cols() } else { 0 }];
+            let mut missing = keep_columns.then(|| vec![0u64; len.div_ceil(64) * data.n_cols()]);
+            let block = BinBlock {
+                rows,
